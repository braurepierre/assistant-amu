# Secrets — never commit (PRD §9 : fuite de secrets rédhibitoire)
.env

# Local vector store (regenerated from the corpus)
chroma_db/

# Downloaded corpus binaries — reproducibility via sources.yaml + scripts (PRD §7.1)
corpus/raw/

# Cache des contextes générés (Contextual Retrieval, §5.3.1) — donnée dérivée du
# corpus, au même titre que chroma_db/ : régénérée par la commande contextualize.
corpus/contexts.jsonl

