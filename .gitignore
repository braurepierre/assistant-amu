# Secrets — never commit (PRD §9 : fuite de secrets rédhibitoire)
.env

# Local vector store (regenerated from the corpus)
chroma_db/

# Downloaded corpus binaries — reproducibility via sources.yaml + scripts (PRD §7.1)
corpus/raw/

# NOTE : corpus/contexts.jsonl est délibérément VERSIONNÉ, contrairement aux deux
# entrées ci-dessus. C'est aussi une donnée dérivée, mais les collections qui ont
# produit les rapports du §5.3.1 ont disparu de chroma_db/ : ce cache est devenu
# leur unique chemin de reproduction. L'exclure rendait `eval/repro_contextual_
# retrieval.py` gratuit sur ce poste seulement — un tiers aurait dû repayer ~316
# appels de modèle. 143 Ko contre la reproductibilité des mesures publiées.

# Python
__pycache__/
*.py[cod]
*.egg-info/
build/
dist/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Virtual environments
.venv/
venv/
env/

# Editor / OS
.vscode/
.idea/
.DS_Store
Thumbs.db

# Local Claude Code instructions (kept local, not part of the deliverable)
CLAUDE.md

