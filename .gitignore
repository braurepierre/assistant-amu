# Secrets — never commit (PRD §9 : fuite de secrets rédhibitoire)
.env

# Local vector store (regenerated from the corpus)
chroma_db/

# Downloaded corpus binaries — reproducibility via sources.yaml + scripts (PRD §7.1)
corpus/raw/

# Cache des contextes générés (Contextual Retrieval, §5.3.1) — donnée dérivée du
# corpus, au même titre que chroma_db/ : régénérée par la commande contextualize.
corpus/contexts.jsonl

# Dossiers remis aux juges — dérivés de bundles.json par blind_rejudge_prompts.py,
# régénérés à l'identique par la commande du README. Ce qui fonde les verdicts,
# et n'est pas reproductible autrement, reste versionné : bundles, clé, verdicts.
eval/reports/*/briefs/

# Python
__pycache__/
*.py[cod]
*.egg-info/
build/
dist/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Virtual environments
.venv/
venv/
env/

# Editor / OS
.vscode/
.idea/
.DS_Store
Thumbs.db

# Local Claude Code instructions (kept local, not part of the deliverable)
CLAUDE.md
