# AssistantAMU — example environment file.
# Copy to `.env` (git-ignored) and fill in real values. Never commit `.env`.

# --- LLM backend selection (PRD §7.4) ---
# ollama = local (default) | mistral = Mistral La Plateforme API
LLM_BACKEND=ollama
# Sampling temperature, low for factuality
LLM_TEMPERATURE=0.2

# --- Ollama (local backend) ---
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=mistral
# Context window Ollama actually allocates. Ollama silently truncates the prompt
# to num_ctx, NOT to the model's capacity (PRD piège n°3, §7.4). Fall back to
# 4096 on a modest machine (and keep k <= 5).
OLLAMA_NUM_CTX=8192
OLLAMA_TIMEOUT_S=120

# --- Mistral La Plateforme (API backend) ---
# Required only when LLM_BACKEND=mistral. Create the key yourself on the
# platform; it is never generated by the developer.
MISTRAL_API_KEY=your-mistral-api-key-here
MISTRAL_MODEL=mistral-small-latest
MISTRAL_TIMEOUT_S=30

# --- Retrieval & indexing (PRD §7.3) ---
EMBEDDING_MODEL=intfloat/multilingual-e5-small
CHROMA_PATH=./chroma_db
CHROMA_COLLECTION=amu_docs
TOP_K=5

# --- Chunking (PRD §7.2) ---
CHUNK_MAX_TOKENS=500
CHUNK_OVERLAP=50
