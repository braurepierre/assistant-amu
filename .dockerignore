# Contexte de build : tout ce qui n'entre pas dans l'image (et surtout le secret).
.env
.venv/
venv/
env/

# Données régénérables, jamais embarquées : l'index vit dans le volume /data,
# le corpus téléchargé se reconstitue depuis corpus/sources.yaml.
chroma_db/
corpus/raw/
# Versionné dans git (il porte la reproductibilité des mesures du §5.3.1), mais
# hors de l'image : l'expérience de contextualisation ne s'exécute pas en
# conteneur, le service n'en a aucun usage.
corpus/contexts.jsonl

# Historique et outillage local
.git/
.github/
.pytest_cache/
.mypy_cache/
.ruff_cache/
__pycache__/
*.py[cod]
*.egg-info/
build/
dist/

# Rapports et tests : hors périmètre de l'exécution
eval/reports/
tests/
CLAUDE.md

# docs/ entre dans le contexte : l'étape « site » construit le site de
# documentation, que l'image sert sous /site. Seuls ses produits en sont exclus,
# reconstruits à chaque image.
docs/site/content/
docs/site/output/
